# Install as /etc/nginx/sites-available/o-espertinho after replacing the hostnames.
# Enable the site, validate with nginx -t, then issue HTTPS with Certbot.
server {
    listen 80;
    server_name www.seu-dominio.example;
    return 301 https://seu-dominio.example$request_uri;
}
server {
    listen 80;
    server_name seu-dominio.example;
    location / {
        proxy_pass http://127.0.0.1:4200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
    }
}
