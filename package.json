{
  "name": "espertinho-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "typecheck": "ngc --noEmit -p tsconfig.app.json",
    "start": "node dist/espertinho/server/server.mjs",
    "test:e2e": "playwright test",
    "test:coverage": "c8 node --experimental-strip-types --test test/*.test.mjs",
    "validate:html": "html-validate src/index.html",
    "prebuild": "node scripts/prepare-csp.mjs",
    "build:coverage": "ng build --configuration production,coverage",
    "coverage:merge": "c8 --all=false --include=scripts/ci/merge-browser-coverage.mjs --reports-dir=coverage/collector node scripts/ci/merge-browser-coverage.mjs",
    "prebuild:coverage": "node scripts/prepare-csp.mjs"
  },
  "dependencies": {
    "@angular/common": "~22.2.3",
    "@angular/compiler": "~22.2.3",
    "@angular/core": "~22.2.3",
    "@angular/forms": "~22.2.3",
    "@angular/platform-browser": "~22.2.3",
    "@angular/platform-server": "~22.2.3",
    "@angular/router": "~22.2.3",
    "@angular/ssr": "~22.2.2",
    "express": "^5.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~22.2.2",
    "@angular/cli": "~22.2.2",
    "@angular/compiler-cli": "~22.2.3",
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "c8": "12.0.0",
    "esbuild": "0.25.12",
    "html-validate": "11.16.3",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "typescript": "~6.0.0",
    "v8-to-istanbul": "9.3.0"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "vite": "8.3.3"
  },
  "packageManager": "npm@11.19.0"
}
